# 本文件只保留当前主线配置。真实密钥写入未跟踪的 .env 或密钥系统。

# V4 Python Compose image / host binding
WZK_PYTHON_IMAGE=wzk-ai-voice-python
WZK_IMAGE_TAG=dev
AI_VOICE_HOST_BIND_IP=127.0.0.1

# server-config / Admin
CONFIG_DATABASE_URL=mysql://user:password@127.0.0.1:3306/wzk_ai_voice?charset=utf8mb4
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=43200
ADMIN_COOKIE_SECURE=false
ADMIN_AUTH_DISABLED=false
GATEWAY_INTERNAL_BASE_URL=http://127.0.0.1:7860

# Python Gateway / internal gRPC
GATEWAY_BIND_HOST=0.0.0.0
GATEWAY_BIND_PORT=7860
GATEWAY_REQUIRE_ROBOT_SECRET=true
GATEWAY_COMPLEX_WORKFLOW_ENABLED=false
GATEWAY_INTERNAL_VOICE_WS_ENABLED=true
GATEWAY_INTERNAL_VOICE_CLIENT_EVENT_MODE=active
STT_SERVICE_URL=grpc://127.0.0.1:50054
LLM_SERVICE_URL=grpc://127.0.0.1:50053
TTS_SERVICE_URL=grpc://127.0.0.1:50052
STT_AUDIO_CONTEXT_TO_LLM=true
STT_GRPC_SERVER_PORT=50054
STT_GRPC_MAX_WORKERS=10
LLM_GRPC_SERVER_PORT=50053
LLM_GRPC_MAX_WORKERS=10
TTS_GRPC_SERVER_PORT=50052
TTS_GRPC_MAX_WORKERS=5
LLM_TTS_IDLE_TIMEOUT_SEC=20
LLM_TTS_THREAD_JOIN_TIMEOUT_SEC=5

# Go Realtime Edge Gateway
GO_VOICE_GATEWAY_ADDR=0.0.0.0:8282
GO_VOICE_GATEWAY_RTC_ENABLED=true
GO_VOICE_GATEWAY_REQUIRE_ROBOT_SECRET=true
GO_VOICE_GATEWAY_DEVICE_AUTH_BACKEND=python_gateway
GO_VOICE_GATEWAY_ASR_PROCESSOR=python_gateway
GO_VOICE_GATEWAY_ASR_PYTHON_GATEWAY_WS_URL=ws://127.0.0.1:7860/ws
GO_VOICE_GATEWAY_ASR_PYTHON_GATEWAY_CONNECTION_MODE=session
GO_VOICE_GATEWAY_ASR_PYTHON_GATEWAY_SESSION_IDLE_RECYCLE_MS=30000
GO_VOICE_GATEWAY_DOWNLINK_AUDIO_TRANSPORT=webrtc_rtp
GO_VOICE_GATEWAY_ICE_TRANSPORT_POLICY=all
GO_VOICE_GATEWAY_ICE_NETWORK_TYPES=udp4
GO_VOICE_GATEWAY_RTC_UDP_MIN_PORT=35500
GO_VOICE_GATEWAY_RTC_UDP_MAX_PORT=35600
# 生产 TURN 必须在本地 .env 中以单行 JSON 注入，禁止提交 credential。
GO_VOICE_GATEWAY_ICE_SERVERS=

# Rust Client（设备侧单独配置）
GATEWAY_URL=ws://127.0.0.1:8282/ws
ROBOT_ID=
ROBOT_SECRET=
TRANSPORT_POLICY=webrtc_only
WEBRTC_ENABLED=true
TRANSPORT_FALLBACK_ENABLED=false
WEBRTC_OFFER_FACTORY=native
RTC_AUDIO_UPLINK=rtp_only
VAD_MODE=2
VAD_SPEECH_START_MIN_DBFS=-36
VAD_SILENCE_THRESHOLD=0.5
VAD_SPEECH_THRESHOLD=0.25
VAD_SPEECH_TRIGGER_RATIO=0.6
VAD_MAX_RECORDING_DURATION=10
# Rust Client：端侧 VAD 与 candidate 状态机。
TURN_GATE_SHADOW_ENABLED=false
TURN_GATE_ACTIVE_ENABLED=true
NATURAL_BARGE_IN_ENABLED=false
TURN_GATE_CANDIDATE_SILENCE_MS=300
TURN_GATE_MIN_COMMIT_SILENCE_MS=600
TURN_GATE_FAILURE_FALLBACK_MS=1000
TURN_GATE_AMBIGUOUS_HARD_TIMEOUT_MS=1600

# Go Voice Gateway：不继承 Rust 或 Python 的开关。
GO_VOICE_GATEWAY_TURN_GATE_SHADOW_ENABLED=false
GO_VOICE_GATEWAY_TURN_GATE_ACTIVE_ENABLED=false
GO_VOICE_GATEWAY_TURN_GATE_ACTIVE_DEADLINE_MS=300
GO_VOICE_GATEWAY_TURN_GATE_SHADOW_TIMEOUT_MS=5000
GO_VOICE_GATEWAY_TURN_GATE_SHADOW_SNAPSHOT_GRACE_MS=30
GO_VOICE_GATEWAY_BARGE_IN_ENABLED=true

# Python Gateway：候选 ASR、Smart Turn 与 LiveKit EOU。
GATEWAY_TURN_GATE_SHADOW_ENABLED=false
GATEWAY_TURN_GATE_ACTIVE_ENABLED=false
GATEWAY_TURN_GATE_MODELS_ENABLED=false
GATEWAY_TURN_GATE_SMART_THRESHOLD=0.5
GATEWAY_TURN_GATE_EOU_THRESHOLD=0.0066
GATEWAY_BARGE_IN_ENABLED=true
# 生产环境建议显式指向固定 revision/hash 的外部模型目录。
# GATEWAY_TURN_GATE_SMART_MODEL_PATH=/models/smart-turn-v3.2-cpu.onnx
# GATEWAY_TURN_GATE_EOU_MODEL_DIR=/models/livekit-eou-v0.4.1-intl

# Qwen3-ASR
STT_PROVIDER=qwen
QWEN_ASR_BASE_URL=http://127.0.0.1:15110/v1
QWEN_ASR_API_KEY=
QWEN_ASR_MODEL=Qwen3-ASR-1.7B
QWEN_ASR_TIMEOUT=30
STT_MAX_CONCURRENT_INFERENCES=8

# LLM / Router
LLM_BASE_URL=http://127.0.0.1:15101/v1
LLM_API_KEY=
LLM_MODEL_NAME=qwen3-5-9b
LLM_ROUTER_BASE_URL=http://127.0.0.1:15100/v1
LLM_ROUTER_API_KEY=
LLM_ROUTER_MODEL_NAME=qwen3-5-4b
LLM_TOOL_LATENCY_EXPERIMENT=true
LLM_TOOL_ROUTER_CLASSIFIER=true
LLM_TOOL_ROUTER_CLASSIFIER_TIMEOUT_MS=3000
LLM_TOOL_ROUTER_CLASSIFIER_MAX_TOKENS=1
LLM_TOOL_ROUTER_CLASSIFIER_PROMPT_CHAR_LIMIT=8192
LLM_TOOL_ROUTER_CLASSIFIER_HISTORY_MESSAGES=10
LLM_TOOL_ROUTER_CLASSIFIER_HISTORY_MESSAGE_CHARS=200
LLM_TOOL_ROUTER_CLASSIFIER_HISTORY_CHAR_BUDGET=700
LLM_TOOL_ROUTER_CLASSIFIER_FALLBACK_HISTORY_MESSAGES=3
LLM_COMPLEX_WORKFLOW_ENABLED=false
LLM_VISION_GATEWAY_BASE_URL=http://127.0.0.1:8282
# 三个变量必须解析为同一令牌：裸 LLM、裸 Go Gateway 与 Compose 两端共用。
LLM_VISION_GATEWAY_TOKEN=
VISION_INTERNAL_TOKEN=${LLM_VISION_GATEWAY_TOKEN}
GO_VOICE_GATEWAY_VISION_INTERNAL_TOKEN=${VISION_INTERNAL_TOKEN}

# Qwen3-TTS Profile providers
QWEN3_TTS_CUSTOM_VOICE_WS_URL=ws://127.0.0.1:15120/v1/audio/speech/stream
QWEN3_TTS_CUSTOM_VOICE_API_KEY=
QWEN3_TTS_CUSTOM_VOICE_MODEL=qwen3-tts
QWEN3_TTS_BASE_WS_URL=ws://127.0.0.1:15121/v1/audio/speech/stream
QWEN3_TTS_BASE_API_KEY=
QWEN3_TTS_BASE_MODEL=qwen3-tts-base
LOCAL_QWEN3_TTS_SUPPORTED_VOICES=serena,aiden,dylan,eric,ono_anna,ryan,sohee,uncle_fu,vivian
LOCAL_QWEN3_TTS_LANGUAGE=Chinese
LOCAL_QWEN3_TTS_SOURCE_SAMPLE_RATE=24000
LOCAL_QWEN3_TTS_CONNECT_TIMEOUT_SEC=8
LOCAL_QWEN3_TTS_RECV_TIMEOUT_SEC=60

# AI 唱歌库：歌曲成品不提交 Git，本地运行时指向已校验的 16kHz mono PCM16 WAV 目录。
SINGING_CATALOG_PATH=singing/catalog.json
SINGING_VOICES_PATH=singing/voices.json
SINGING_AUDIO_ROOT=singing/audio
# Compose 部署建议覆盖为宿主机绝对路径；仓库内默认目录仅用于本地运行。
SINGING_AUDIO_HOST_DIR=../../singing/audio
# 根 docker-compose.v4.yml 使用；生产请覆盖为绝对路径。
SINGING_AUDIO_V4_HOST_DIR=./singing/audio
SINGING_DEFAULT_VOICE_ID=serena-v1
SINGING_MCP_PORT=5005

# Optional MCP / MQTT integrations
MCP_ENABLED=true
ROBOT_MQTT_HOST=
ROBOT_MQTT_PORT=1883
ROBOT_MQTT_USERNAME=
ROBOT_MQTT_PASSWORD=
ROBOT_MQTT_TOPIC_PREFIX=windaka
ROBOT_MQTT_DEFAULT_ROBOT_ID=
COGNITIVE_REPORT_MQTT_ENABLED=false
COGNITIVE_REPORT_MQTT_HOST=
COGNITIVE_REPORT_MQTT_PORT=1883
COGNITIVE_REPORT_MQTT_USERNAME=
COGNITIVE_REPORT_MQTT_PASSWORD=
COGNITIVE_REPORT_MQTT_TOPIC_PREFIX=
COGNITIVE_REPORT_TOPIC_SUFFIX=device/cog_ass_report
COGNITIVE_REPORT_METHOD=/device/cog_ass_report
COGNITIVE_REPORT_MSG_ID=7
WEBSEARCH_API_KEY=
