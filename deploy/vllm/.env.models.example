# Copy to deploy/vllm/.env.models, then edit paths, GPU ids, ports, and keys.

AI_VOICE_DOCKER_NETWORK=wzk-ai-net
VLLM_MODEL_HOST_ROOT=/home/chase/datasets/wzk/models
VLLM_HF_CACHE_HOST_ROOT=/home/chase/datasets/wzk/hf-cache
VLLM_LOG_MAX_SIZE=100m
VLLM_LOG_MAX_FILE=5

# Qwen3 ASR
VLLM_STT_IMAGE=wzk/vllm-qwen3-asr:v0.21.0-audio
VLLM_STT_HOST_PORT=15110
VLLM_STT_CUDA_VISIBLE_DEVICES=0
VLLM_STT_MODEL_PATH=/models/Qwen3-ASR-1.7B
VLLM_STT_SERVED_MODEL_NAME=Qwen3-ASR-1.7B
VLLM_STT_GPU_MEMORY_UTILIZATION=0.80
VLLM_STT_MAX_MODEL_LEN=4096
VLLM_STT_API_KEY=

# Main LLM
VLLM_LLM_IMAGE=vllm/vllm-openai:v0.21.0
VLLM_LLM_HOST_PORT=15101
VLLM_LLM_CUDA_VISIBLE_DEVICES=0
VLLM_LLM_MODEL_PATH=/models/qwen3-5-9b
VLLM_LLM_SERVED_MODEL_NAME=qwen3-5-9b
VLLM_LLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_LLM_MAX_MODEL_LEN=32768
VLLM_LLM_API_KEY=

# Router LLM
VLLM_ROUTER_IMAGE=vllm/vllm-openai:v0.21.0
VLLM_ROUTER_HOST_PORT=15100
VLLM_ROUTER_CUDA_VISIBLE_DEVICES=0
VLLM_ROUTER_MODEL_PATH=/models/qwen3-5-4b
VLLM_ROUTER_SERVED_MODEL_NAME=qwen3-5-4b
VLLM_ROUTER_GPU_MEMORY_UTILIZATION=0.60
VLLM_ROUTER_MAX_MODEL_LEN=8192
VLLM_ROUTER_MAX_NUM_SEQS=16
VLLM_ROUTER_MAX_NUM_BATCHED_TOKENS=8192
VLLM_ROUTER_API_KEY=

# TTS
VLLM_TTS_IMAGE=vllm/vllm-omni:v0.22.0
VLLM_TTS_HOST_PORT=15120
VLLM_TTS_CUDA_VISIBLE_DEVICES=0
VLLM_TTS_MODEL_PATH=/models/qwen3-tts
VLLM_TTS_SERVED_MODEL_NAME=qwen3-tts
VLLM_TTS_API_KEY=
VLLM_TTS_STAGE_OVERRIDES={"0":{"max_num_seqs":16,"gpu_memory_utilization":0.55},"1":{"max_num_seqs":16,"gpu_memory_utilization":0.40}}

# Optional mini LLM profile
VLLM_LLM_MINI_IMAGE=vllm/vllm-openai:v0.21.0
VLLM_LLM_MINI_HOST_PORT=15102
VLLM_LLM_MINI_CUDA_VISIBLE_DEVICES=0
VLLM_LLM_MINI_MODEL_PATH=/models/qwen3-5-mini
VLLM_LLM_MINI_SERVED_MODEL_NAME=qwen3-5-mini
VLLM_LLM_MINI_GPU_MEMORY_UTILIZATION=0.60
VLLM_LLM_MINI_MAX_MODEL_LEN=8192
VLLM_LLM_MINI_MAX_NUM_SEQS=16
VLLM_LLM_MINI_MAX_NUM_BATCHED_TOKENS=8192
VLLM_LLM_MINI_API_KEY=
