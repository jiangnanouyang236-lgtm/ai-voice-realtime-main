# Copy this file to .env or pass it with:
#   docker compose --env-file deploy/env.v3.compose.example -f docker-compose.v3.yml config

# External service endpoints and credentials.
AI_VOICE_DOCKER_NETWORK=wzk-ai-net
# Host-published business service ports bind to loopback by default.
# Go Gateway uses host network and is intentionally exposed through GO_VOICE_GATEWAY_ADDR.
AI_VOICE_HOST_BIND_IP=127.0.0.1

LLM_BASE_URL=http://vllm-llm:8000/v1
LLM_API_KEY=
LLM_MODEL_NAME=qwen3-5-9b
LLM_ROUTER_BASE_URL=http://vllm-router:8000/v1
LLM_ROUTER_API_KEY=
LLM_ROUTER_MODEL_NAME=qwen3-5-4b

STT_PROVIDER=qwen
QWEN_ASR_BASE_URL=http://vllm-stt:8000/v1
QWEN_ASR_API_KEY=
QWEN_ASR_MODEL=Qwen3-ASR-1.7B

QWEN3_TTS_CUSTOM_VOICE_WS_URL=ws://vllm-tts:8000/v1/audio/speech/stream
QWEN3_TTS_CUSTOM_VOICE_API_KEY=
QWEN3_TTS_CUSTOM_VOICE_MODEL=qwen3-tts
QWEN3_TTS_BASE_WS_URL=ws://vllm-tts-base:8000/v1/audio/speech/stream
QWEN3_TTS_BASE_API_KEY=
QWEN3_TTS_BASE_MODEL=qwen3-tts-base
LOCAL_QWEN3_TTS_SUPPORTED_VOICES=serena,aiden,dylan,eric,ono_anna,ryan,sohee,uncle_fu,vivian
LOCAL_QWEN3_TTS_LANGUAGE=Chinese
LOCAL_QWEN3_TTS_SOURCE_SAMPLE_RATE=24000
LOCAL_QWEN3_TTS_CONNECT_TIMEOUT_SEC=8
LOCAL_QWEN3_TTS_RECV_TIMEOUT_SEC=60

CONFIG_DATABASE_URL=
WEBSEARCH_API_KEY=
VISION_INTERNAL_TOKEN=

# Gateway auth.
GATEWAY_REQUIRE_ROBOT_SECRET=true
GO_VOICE_GATEWAY_REQUIRE_ROBOT_SECRET=true

# Go Gateway uses host network. It listens on the host address directly.
GO_VOICE_GATEWAY_IMAGE=ai-voice-go-gateway:ubuntu22-amd64
GO_VOICE_GATEWAY_TURN_GATE_SHADOW_ENABLED=false
GO_VOICE_GATEWAY_TURN_GATE_ACTIVE_ENABLED=false
GO_VOICE_GATEWAY_TURN_GATE_ACTIVE_DEADLINE_MS=300
GO_VOICE_GATEWAY_TURN_GATE_SHADOW_TIMEOUT_MS=5000
GO_VOICE_GATEWAY_TURN_GATE_SHADOW_SNAPSHOT_GRACE_MS=30
GO_VOICE_GATEWAY_BARGE_IN_ENABLED=true
GATEWAY_TURN_GATE_SHADOW_ENABLED=false
GATEWAY_TURN_GATE_ACTIVE_ENABLED=false
GATEWAY_TURN_GATE_MODELS_ENABLED=false
GATEWAY_TURN_GATE_SMART_THRESHOLD=0.5
GATEWAY_TURN_GATE_EOU_THRESHOLD=0.0066
GATEWAY_BARGE_IN_ENABLED=true
GO_VOICE_GATEWAY_ADDR=0.0.0.0:8282
GO_VOICE_GATEWAY_ASR_PYTHON_GATEWAY_WS_URL=ws://127.0.0.1:7860/ws
GO_VOICE_GATEWAY_ASR_PYTHON_GATEWAY_TOTAL_TIMEOUT_MS=45000
GO_VOICE_GATEWAY_ASR_PYTHON_GATEWAY_SESSION_IDLE_RECYCLE_MS=30000
GO_VOICE_GATEWAY_ALLOWED_ORIGINS=*
# Leave empty to use the public STUN-only default. Production TURN credentials
# must be injected with a single-line JSON ICE server list; never commit them.
# Example:
# GO_VOICE_GATEWAY_ICE_SERVERS=[{"urls":["stun:stun.example.com:3478"]},{"urls":["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp","turns:turn.example.com:443?transport=tcp"],"username":"<turn-user>","credential":"<turn-password>"}]
GO_VOICE_GATEWAY_ICE_SERVERS=
GO_VOICE_GATEWAY_ICE_TRANSPORT_POLICY=all
GO_VOICE_GATEWAY_ICE_NETWORK_TYPES=udp4
GO_VOICE_GATEWAY_RTC_UDP_MIN_PORT=35500
GO_VOICE_GATEWAY_RTC_UDP_MAX_PORT=35600

# Host loopback ports used by Go Gateway and local smoke checks.
PYTHON_GATEWAY_HOST_PORT=7860
STT_GRPC_HOST_PORT=50054
LLM_GRPC_HOST_PORT=50053
LLM_ADMIN_HOST_PORT=18053
TTS_GRPC_HOST_PORT=50052
TTS_ADMIN_HOST_PORT=18052
ADMIN_API_HOST_PORT=18100

# Admin UI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=43200
ADMIN_COOKIE_SECURE=false
ADMIN_AUTH_DISABLED=false

# Optional local MCP profile.
MCP_ENABLED=true
MCP_SINGING_HOST_PORT=5005
SINGING_AUDIO_HOST_DIR=../../singing/audio
# 根 docker-compose.v4.yml 使用；生产请覆盖为绝对路径。
SINGING_AUDIO_V4_HOST_DIR=./singing/audio
ROBOT_MQTT_HOST=
ROBOT_MQTT_PORT=1883
ROBOT_MQTT_USERNAME=
ROBOT_MQTT_PASSWORD=
ROBOT_MQTT_TOPIC_PREFIX=windaka
ROBOT_MQTT_DEFAULT_ROBOT_ID=companion_01
