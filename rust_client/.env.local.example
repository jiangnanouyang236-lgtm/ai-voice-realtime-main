# Copy this file to .env.local for local RustClient runs.
# .env.local is ignored by git and may contain secrets.

GATEWAY_URL=ws://127.0.0.1:8282/ws
ROBOT_ID=test_01
ROBOT_SECRET=

# Optional, but recommended when multiple USB serial devices exist.
# WAKE_SERIAL_PORT=/dev/cu.usbserial-110

# Optional local audio frontend overrides. The tracked
# run.audio_frontend_tcp.sh script already defaults to these values.
AUDIO_FRONTEND_MODE=tcp
AUDIO_FRONTEND_HOST=127.0.0.1
AUDIO_FRONTEND_MIC_PORT=39001
AUDIO_FRONTEND_SPEAKER_PORT=39002
AUDIO_FRONTEND_CONTROL_PORT=39003
AUDIO_FRONTEND_MUTE_MIC_DURING_PLAYBACK=false
TTS_BARGE_IN_WITH_AEC=false
NATURAL_BARGE_IN_ENABLED=false
WAKE_CAPTURE_PREBUFFER_MS=800

# run.audio_frontend_tcp.sh defaults to KWS wake and ignores inherited
# WAKE_SOURCE_MODE. Use RUN_AUDIO_FRONTEND_WAKE_SOURCE_MODE=both if you want
# hardware/HTTP wake and KWS together for that script.
RUN_AUDIO_FRONTEND_WAKE_SOURCE_MODE=kws
KWS_WAKE_HOST=127.0.0.1
KWS_WAKE_PORT=39004
KWS_WAKE_RECONNECT_SEC=1.0
